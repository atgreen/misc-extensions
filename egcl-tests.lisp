(require :asdf)
(push (uiop:pathname-directory-pathname *load-truename*) asdf:*central-registry*)
(asdf:load-asd (merge-pathnames "misc-extensions.asd" *load-truename*))
(asdf:load-system :misc-extensions)
(deftype egcl-small () '(integer 0 9))
(assert (new-let::type-specifier-name? 'egcl-small))
(assert (new-let::type-specifier-name? 'integer))
(assert (not (new-let::type-specifier-name? 'egcl-not-a-type)))
(assert (= 3 (new-let:let ((x 3)) (declare (egcl-small x)) x)))
(assert (equal '(2 3 4) (gmap:gmap :list #'1+ (:list '(1 2 3)))))
;; Each source starts from the same counter, as independent compiler processes
;; can. The same local type name in distinct packages must remain distinct.
(let ((root (uiop:pathname-directory-pathname *load-truename*)))
  (dolist (file '("tests/egcl-left.lisp" "tests/egcl-right.lisp"))
    (let ((*gensym-counter* 0))
      (load (compile-file (merge-pathnames file root))))))
(assert (not (eq (get 'egcl-gmap-left::items 'gmap::arg-type-expander)
                 (get 'egcl-gmap-right::items 'gmap::arg-type-expander))))
(assert (equal '(1 2 3)
               (gmap:gmap :list #'identity (:arg egcl-gmap-left::items '(1 2 3)))))
(assert (equal '(3 2 1)
               (gmap:gmap :list #'identity (:arg egcl-gmap-right::items '(1 2 3)))))
(format t "MISC-EXTENSIONS-EGCL-PASS~%")
